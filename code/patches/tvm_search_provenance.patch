+ffi::Map<ffi::String, ffi::Any> SerializeProvenance(const SearchCandidate& candidate) {
+  std::vector<std::shared_ptr<const MutationProvenance>> lineage;
+  for (std::shared_ptr<const MutationProvenance> step = candidate.lineage; step;
+       step = step->parent) {
+    lineage.push_back(step);
+  }
