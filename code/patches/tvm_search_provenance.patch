+    const MutationProvenance& step = *lineage[index];
+    ffi::Map<ffi::String, ffi::Any> mutation;
+    mutation.Set("mutation_index", static_cast<int64_t>(index));
+    mutation.Set("generation", static_cast<int64_t>(step.generation));
+    mutation.Set("thread_id", static_cast<int64_t>(step.thread_id));
+    mutation.Set("retry_index", static_cast<int64_t>(step.retry_index));
+    mutation.Set("parent_population_index",
