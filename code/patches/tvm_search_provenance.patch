+ffi::Array<MeasureCandidate> AssembleCandidatesWithProvenance(
+    const std::vector<SearchCandidate>& picks) {
+  ffi::Array<MeasureCandidate> measure_inputs;
+  measure_inputs.reserve(picks.size());
+  for (const SearchCandidate& candidate : picks) {
+    const Schedule& sch = candidate.sch;
+    measure_inputs.push_back(MeasureCandidate(
+        sch, ArgInfo::FromEntryFunc(sch->mod(), /*remove_preproc=*/true),
+        SerializeProvenance(candidate)));
+  }
+  return measure_inputs;
