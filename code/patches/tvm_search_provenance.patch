+    mutation.Set("mutator_type", step.mutator_type);
+    mutation.Set("rng_state_before", static_cast<int64_t>(step.rng_state_before));
+    mutation.Set("rng_state_after", static_cast<int64_t>(step.rng_state_after));
+    mutation.Set("parent_normalized_score", step.parent_normalized_score);
+    mutation.Set("parent_trace_json", step.parent_trace->AsJSON(/*remove_postproc=*/true));
+    mutation.Set("mutated_trace_json", step.mutated_trace->AsJSON(/*remove_postproc=*/true));
+    mutations.push_back(std::move(mutation));
+  }
+
+  ffi::Map<ffi::String, ffi::Any> origin;
+  origin.Set("type", candidate.root_source);
+  origin.Set("source_index", static_cast<int64_t>(candidate.root_source_index));
+  origin.Set("initial_population_slot",
+             static_cast<int64_t>(candidate.initial_population_slot));
+
+  ffi::Map<ffi::String, ffi::Any> selection;
+  selection.Set("source", candidate.selection_source);
+  if (candidate.has_predicted_score) {
+    selection.Set("predicted_normalized_score", candidate.predicted_normalized_score);
+  }
+
+  ffi::Map<ffi::String, ffi::Any> provenance;
+  provenance.Set("schema_version", static_cast<int64_t>(1));
+  provenance.Set("available", true);
+  provenance.Set("strategy", ffi::String("evolutionary"));
+  provenance.Set("origin", std::move(origin));
+  provenance.Set("root_trace_json",
+                 candidate.root_trace->AsJSON(/*remove_postproc=*/true));
+  provenance.Set("mutation_count", static_cast<int64_t>(mutations.size()));
+  provenance.Set("mutations", std::move(mutations));
+  provenance.Set("selection", std::move(selection));
+  provenance.Set(
+      "final_trace_json_without_postproc",
+      candidate.sch->trace().value()->AsJSON(/*remove_postproc=*/true));
+  return provenance;
+}
